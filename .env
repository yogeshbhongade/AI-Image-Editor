# Flask Configuration
FLASK_SECRET_KEY=your-super-secret-key-change-in-production
FLASK_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB=image_editor

# Session Configuration
SESSION_PERMANENT=False

# Redis + RQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
RQ_QUEUE_NAME=image_tasks
RQ_JOB_TIMEOUT=300
ALLOW_START_WITHOUT_REDIS=1

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# AI Horde Configuration
AI_HORDE_API_KEY=
AI_PRIMARY_PROVIDER=cloudflare
AI_FALLBACK_PROVIDER=
AI_DEFAULT_MODEL=@cf/stabilityai/stable-diffusion-xl-base-1.0
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=60

# Hugging Face Configuration
HF_API_TOKEN=
HF_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Razorpay Payment Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
PREMIUM_PLAN_AMOUNT=29900
PREMIUM_PLAN_INTERVAL=monthly
RAZORPAY_PLAN_ID=
PAYMENT_SUCCESS_URL=http://localhost:5000/payment/success
PAYMENT_CANCEL_URL=http://localhost:5000/payment/cancel

# Security Configuration
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_USER=100
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_UPLOAD=10 per hour
RATE_LIMIT_AUTH=5 per minute
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' checkout.razorpay.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' fonts.gstatic.com
ALLOWED_HOSTS=localhost,127.0.0.1
SECURITY_LOG_LEVEL=INFO